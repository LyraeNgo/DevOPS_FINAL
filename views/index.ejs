<%- include('partials/head') %>

  <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div class="text-muted small">
      Manage your product catalog
      <span class="badge text-bg-light border ms-1"><%= products.length %> items</span>
    </div>
    <button id="btn-add" class="btn btn-primary btn-sm">Add Product</button>
  </div>

  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th scope="col" style="width:80px">Photo</th>
            <th scope="col">Name</th>
            <th scope="col" class="text-end">Price</th>
            <th scope="col">Color</th>
            <th scope="col">Description</th>
            <th scope="col" style="width:150px">Actions</th>
          </tr>
        </thead>
        <tbody id="product-table">
          <% if (!products || products.length === 0) { %>
            <tr>
              <td colspan="6" class="text-center text-muted py-4">
                No products yet. Click <strong>Add Product</strong> to create one.
              </td>
            </tr>
          <% } %>
          <% (products || []).forEach(function(p){ %>
            <tr data-id="<%= p.id %>" data-image="<%= p.imageUrl || '' %>">
              <td>
                <img
                  src="<%= p.imageUrl && p.imageUrl.length ? p.imageUrl : '/images/placeholder-80.png' %>"
                  alt="<%= p.name ? (p.name + ' photo') : 'Product photo' %>"
                  class="img-thumbnail"
                  style="width:60px;height:60px;object-fit:cover"
                  loading="lazy"
                >
              </td>
              <td class="fw-medium"><%= p.name %></td>
              <td class="text-end"><%= p.price %></td>
              <td><%= p.color %></td>
              <td class="text-truncate" style="max-width: 360px;"><%= p.description || '' %></td>
              <td class="text-nowrap">
                <button class="btn btn-sm btn-outline-secondary btn-edit" type="button" aria-label="Edit product">Edit</button>
                <button class="btn btn-sm btn-outline-danger btn-delete" type="button" aria-label="Delete product">Delete</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal Form -->
  <div class="modal fade" id="productModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form id="product-form">
          <div class="modal-header">
            <h5 class="modal-title" id="modalTitle">Add Product</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" id="product-id">
            <div class="mb-3">
              <label class="form-label">Name</label>
              <input id="name" name="name" type="text" class="form-control" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Price</label>
              <input id="price" name="price" type="number" step="0.01" min="0" class="form-control" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Color</label>
              <input id="color" name="color" type="text" class="form-control" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Description</label>
              <textarea id="description" name="description" class="form-control" rows="2"></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label">Image</label>
              <input id="imageFile" name="imageFile" type="file" accept="image/*" class="form-control">
              <input type="hidden" id="imageUrl" name="imageUrl">
              <div class="mt-2">
                <img id="img-preview" src="/images/placeholder-80.png" alt="Image preview" class="img-thumbnail" style="width:120px;height:120px;object-fit:cover">
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save</button>
          </div>
        </form>
      </div>
    </div>
  </div>

<%- include('partials/footer') %>
